<Page x:Class="Hotel.RoomsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Hotel"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RoomsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">

            <TextBox Name="SearchBox"
                     Width="150"
                     Margin="3"
                     VerticalContentAlignment="Center"
                     ToolTip="Поиск по номеру или типу"
                     TextChanged="SearchBox_TextChanged"/>

            <ComboBox Name="TypeFilterComboBox" Width="130" Margin="3" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="Все типы"/>
                <ComboBoxItem Content="Эконом"/>
                <ComboBoxItem Content="Стандарт"/>
                <ComboBoxItem Content="Комфорт"/>
                <ComboBoxItem Content="Люкс"/>
            </ComboBox>

            <ComboBox Name="StatusFilterComboBox" Width="130" Margin="3" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="Все статусы"/>
                <ComboBoxItem Content="Свободен"/>
                <ComboBoxItem Content="Занят"/>
                <ComboBoxItem Content="Забронирован"/>
                <ComboBoxItem Content="На уборке"/>
            </ComboBox>

            <ComboBox Name="SortComboBox" Width="180" Margin="3" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="Сначала дешёвые"/>
                <ComboBoxItem Content="Сначала дорогие"/>
                <ComboBoxItem Content="По возрастанию вместимости"/>
                <ComboBoxItem Content="По убыванию вместимости"/>
                <ComboBoxItem Content="По номеру комнаты"/>
            </ComboBox>

            <TextBlock Name="CountText" FontSize="14" Margin="5" VerticalAlignment="Center" MinWidth="150" TextWrapping="Wrap"/>
            
            <Button Content="Добавить номер" Height="35" Click="AddButton_Click"/>
        </StackPanel>
        <ListView Name="RoomsListView" Grid.Row="1" >
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition></ColumnDefinition>
                            <ColumnDefinition></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <Image Grid.Column="0" Grid.RowSpan="4" HorizontalAlignment="Center" Width="100" Source="/res/picture.png"></Image>

                        <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Margin="10,0,0,0">
                            <TextBlock Text="{Binding тип_номера}" FontSize="20"/>
                            <TextBlock Text=" | " FontSize="20"/>
                            <TextBlock Text="{Binding номер}" FontSize="20"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,0">
                            <TextBlock Text="Вместимость: " FontSize="18"/>
                            <TextBlock Text="{Binding вместимость}" FontSize="18"/>
                            <TextBlock Text=" чел." FontSize="18"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="2" Orientation="Horizontal" Margin="10,0,0,0">
                            <TextBlock Text="Цена: " FontSize="18"/>
                            <TextBlock Text="{Binding цена_за_сутки}" FontSize="18"/>
                            <TextBlock Text=" ₽ / сутки" FontSize="18"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal" Margin="10,0,0,0">
                            <TextBlock Text="Статус: " FontSize="18"/>
                            <TextBlock Text="{Binding статус}" FontSize="18"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="4" Orientation="Horizontal" Margin="10">

                            <Button Content="Редактировать" Width="130" Margin="0,0,10,0" Click="EditButton_Click"/>

                            <Button Content="Удалить" Width="100" Click="DeleteButton_Click"/>

                        </StackPanel>


                    </Grid>
                </DataTemplate>
                
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="BorderBrush" Value="Black"/>
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                    <Setter Property="Padding" Value="5"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>
